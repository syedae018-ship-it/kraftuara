# Supabase Connection Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Host Routing Variables
NEXT_PUBLIC_ROOT_DOMAIN=symar.com

# Platform Super Admin Configuration
ADMIN_EMAILS=admin@symar.com,owner@platform.com

# Razorpay Subscriptions (Production Settings)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_... # Or rzp_test_... for Sandbox validation
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signature_secret

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0Z2921645B

